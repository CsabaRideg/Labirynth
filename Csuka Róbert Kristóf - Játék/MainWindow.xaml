<Window x:Class="Labirynth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Labirynth"
        mc:Ignorable="d"
        Title="Labyrinth" Height="720" Width="1280"
        MinHeight="720" MinWidth="1280"
        SizeChanged="Window_SizeChanged">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="txtTitle" Text="Labyrinth" Grid.Column="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="36" FontWeight="Bold"/>

            <Label x:Name="lblIdo" Content="" Grid.Column="1"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="36" FontWeight="Bold"/>

            <Button x:Name="btnMegallitas" Grid.Column="2" Margin="20"
                    Click="Jatek_Megallitas" Visibility="Hidden">Játék megállítása</Button>

            <ComboBox x:Name="cmbLanguage" Grid.Column="3" Margin="20"
                      VerticalAlignment="Center"
                      SelectionChanged="cmbLanguage_SelectionChanged">
                <ComboBoxItem Content="Magyar" Tag="hu" IsSelected="True"/>
                <ComboBoxItem Content="English" Tag="en"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Canvas x:Name="cnvPalya" Background="LightGray" Margin="20"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="txtAllas" Text="Helyzet:"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="24" FontWeight="Bold"
                           Margin="0 0 0 10" Visibility="Hidden"/>
                <TextBlock x:Name="txtMission" Text=""
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="24" FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btnBetoltes" Content="Pálya betöltése" Grid.Column="0"
                    Margin="80 40 80 40" Click="Palya_Betoltes"/>
            <Button x:Name="btnMentes" Content="Állás mentése" Grid.Column="1"
                    Margin="80 40 80 40" Click="Allas_Mentese"/>

            <Label x:Name="lblLehetosegek" Grid.Column="2"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="36" FontWeight="Bold"/>
        </Grid>

    </Grid>
</Window>