<Window x:Class="LabyrinthGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabyrinthGame"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="black">
    <Grid>
        <Grid.ColumnDefinitions >
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Margin="5" Background="yellow">
            <StackPanel>
                <StackPanel Orientation="Vertical">
                    <Label x:Name="lblName" Content="Labirintus neve:" FontSize="14" Margin="5"/>
                    <TextBox x:Name="txtLbName"  Margin="5"/>
                </StackPanel>
                <StackPanel Orientation="vertical">
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="lblRows" Content="Sorok szama" VerticalAlignment="Center" FontSize="10" Margin="5" />
                        <TextBlock  x:Name="txtRows" VerticalAlignment="Center" Margin="5" FontSize="10" Text="{Binding ElementName=sliRows, Path=Value}"/>
                    </StackPanel>
                    <Slider x:Name="sliRows" 
                            IsEnabled="True" 
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            Minimum="5" 
                            Maximum="50" 
                            Value="10" 
                            Margin="5" 
                            ValueChanged="sliChanged"/>
                    <StackPanel Orientation="Horizontal" >
                        <Label x:Name="lblCols" Content="Oszlopok szama" VerticalAlignment="Center" FontSize="10" Margin="5" />
                        <TextBlock x:Name="txtColumns" VerticalAlignment="Center" Margin="5" FontSize="10" Text="{Binding ElementName=sliColumns, Path=Value}"/>
                    </StackPanel>
                    <Slider x:Name="sliColumns" 
                            IsEnabled="True" 
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            Minimum="5" 
                            Maximum="50" 
                            Value="10" 
                            Margin="5" 
                            ValueChanged="sliChanged"/>
                </StackPanel>
                <Button Content="Meret zarolas" x:Name="btnLock" Margin="5" Click="LockButton_Click"/>
                <Button Content="Nyelv" x:Name="btnLanguageToggle" Margin="5" Click="btlLanguage_Click"/>
                <Button Content="Betoltes" x:Name="btnImport" Margin="5" Click="btnImport_Click"/>
                <Button Content="Letoltes" x:Name="btnExport" Margin="5" Click="btnExport_Click"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Disabled">
                <UniformGrid x:Name="UgridMap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
